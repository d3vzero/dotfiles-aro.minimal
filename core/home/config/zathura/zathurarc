# Tema hitam putih: tampilan zathura gelap; isi PDF tetap asli.
# Ctrl+R membalik warna halaman (teks putih di latar hitam).
set default-bg              "#000000"
set default-fg              "#e8e8e8"
set statusbar-bg            "#0a0a0a"
set statusbar-fg            "#e8e8e8"
set inputbar-bg             "#000000"
set inputbar-fg             "#ffffff"
set notification-bg         "#0a0a0a"
set notification-fg         "#ffffff"
set notification-error-bg   "#ffffff"
set notification-error-fg   "#000000"
set notification-warning-bg "#e8e8e8"
