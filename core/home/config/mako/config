# Tema hitam putih (dotfiles-aro.minimal)
font=Sans 10
background-color=#0a0a0aeb
text-color=#e8e8e8
border-color=#ffffff
border-size=1
border-radius=0
padding=10
# jarak dari tepi layar: 36 = tinggi bar atas aro (bar_height), supaya bar tidak tertutup
anchor=top-right
outer-margin=36,0,0,0
margin=10
progress-color=over #ffffff33
default-timeout=6000

[urgency=low]
border-color=#555555

[urgency=critical]
border-color=#ffffff
border-size=2
default-timeout=0
