#!/bin/bash
# media-key ACTION -- media & volume keys.
#   play | next | prev | stop   -> playerctl (MPRIS: Sung, Firefox, mpv)
#   up | down | mute            -> wpctl (PipeWire default output), max 100%
#   mic-up | mic-down | mic-mute -> the same for the default input (microphone)
#   mute-all                    -> speaker and microphone together: both muted, or both back on
# Shows one notification that is replaced on each press (no stacking).
set -uo pipefail
ID_FILE="${XDG_RUNTIME_DIR:-/tmp}/media-key.notify-id"

osd() {       # osd TITLE BODY [percent]
    local id new hint=()
    id="$(cat "$ID_FILE" 2>/dev/null || echo 0)"
    [ -n "${3:-}" ] && hint=(-h "int:value:$3")
    new="$(notify-send -a Media -t 1500 -p -r "$id" "${hint[@]}" "$1" "$2" 2>/dev/null)" \
        && echo "$new" > "$ID_FILE"
}

now_playing() {
    sleep 0.4
    local t; t="$(aro-player metadata --format '{{artist}} — {{title}}' 2>/dev/null)"
    [ -n "$t" ] && osd "$1" "$t"
}

volume_osd() {   # volume_osd [@DEFAULT_AUDIO_SINK@|@DEFAULT_AUDIO_SOURCE@] [title]
    local dev="${1:-@DEFAULT_AUDIO_SINK@}" name="${2:-Volume}" v pct
    v="$(wpctl get-volume "$dev" 2>/dev/null)"      # "Volume: 0.45 [MUTED]"
    pct="$(awk '{ printf "%d", $2 * 100 + 0.5 }' <<<"$v")"
    case "$v" in
        *MUTED*) osd "$name muted" "$pct%" "$pct" ;;
        *)       osd "$name" "$pct%" "$pct" ;;
    esac
    aro-bar-refresh audio 2>/dev/null || true       # bar now, not on the next tick
}

# Tombol media ke MPD kalau tidak ada pemutar lain (Sung, Firefox, mpv) yang sedang
# memutar/jeda. Antrean MPD kosong -> isi seluruh perpustakaan (acak), lalu putar.
use_mpd() {
    command -v mpc >/dev/null && mpc -q status >/dev/null 2>&1 || return 1
    ! playerctl -a -f '{{playerName}} {{status}}' status 2>/dev/null |
        grep -v '^mpd' | grep -qE ' (Playing|Paused)$'
}
mpd_ready() {
    [ -n "$(mpc playlist 2>/dev/null | head -n1)" ] && return 0
    mpc -q add / 2>/dev/null; mpc -q random on 2>/dev/null; mpc -q repeat on 2>/dev/null
    [ -n "$(mpc playlist 2>/dev/null | head -n1)" ] || { osd "Musik" "Perpustakaan kosong (~/shared/Musics)"; return 1; }
}

case "${1:-}" in
    play|next|prev)
        if use_mpd; then
            mpd_ready || exit 0
            case "$1" in
                play) mpc -q toggle ;;
                next) mpc -q next 2>/dev/null
                      mpc 2>/dev/null | grep -q '^\[playing\]' || mpc -q play ;;   # dari berhenti: putar
                prev) mpc -q prev 2>/dev/null
                      mpc 2>/dev/null | grep -q '^\[playing\]' || mpc -q play ;;
            esac
            now_playing "MPD"
            exit 0
        fi
        case "$1" in
            play) aro-player play-pause 2>/dev/null || osd "Media" "No player running"
                  now_playing "$(aro-player status 2>/dev/null || echo Media)" ;;
            next) aro-player next 2>/dev/null && now_playing "Next" ;;
            prev) aro-player previous 2>/dev/null && now_playing "Previous" ;;
        esac ;;
    stop) aro-player stop 2>/dev/null && osd "Media" "Stopped" ;;
    up)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
          wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && volume_osd ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && volume_osd ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && volume_osd ;;
    mic-up)   wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
              wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+ && volume_osd @DEFAULT_AUDIO_SOURCE@ Mic ;;
    mic-down) wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%- && volume_osd @DEFAULT_AUDIO_SOURCE@ Mic ;;
    mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && volume_osd @DEFAULT_AUDIO_SOURCE@ Mic ;;
    mute-all) # follow the speaker: it gets toggled, the mic copies its new state
              wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
              if wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED; then
                  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1; osd "Speaker + mic muted" "Fn+mute again to turn both back on"
              else
                  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0; osd "Speaker + mic on" ""
              fi
              aro-bar-refresh audio 2>/dev/null || true ;;
    *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
