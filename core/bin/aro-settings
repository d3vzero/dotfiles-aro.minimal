#!/bin/bash
# aro-settings -- Settings menu (fuzzel): Network, Bluetooth, Display.
# Opened from the launcher (Super+D -> "Settings").
items="Network           Wi-Fi and connections (nmtui)"
if command -v bluetui >/dev/null; then
    items+=$'\n'"Bluetooth         scan, pair, connect (bluetui)"
fi
items+=$'\n'"Display           resolution and refresh rate"

choice="$(printf '%s\n' "$items" | fuzzel --dmenu --font monospace:size=11 \
          --width 55 --lines 6 --prompt 'Settings ❯ ')" || exit 0
case "$choice" in
    Network*)   exec kitty -e nmtui ;;
    Bluetooth*) exec kitty -e bluetui ;;
    Display*)   exec monitor-mode menu ;;
esac
