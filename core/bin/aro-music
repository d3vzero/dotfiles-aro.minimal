#!/bin/bash
# aro-music -- folder musik aktif + shuffle untuk MPD, dengan segmen bar.
#   aro-music folder-menu     fuzzel: "Semua lagu" + semua folder di perpustakaan;
#                             pilih -> antrean = isi folder itu, langsung diputar
#   aro-music shuffle-toggle  SHUFFLE ON/OFF (mpc random)
#   aro-music repeat-toggle   REPEAT ON/OFF: ulangi SATU lagu yang sedang diputar (mpc single +
#                             repeat); OFF = lanjut ke lagu berikutnya seperti biasa
#   aro-music text            tulis segmen "folder" dan "shuffle"
#   aro-music watch           perbarui segmen saat status MPD berubah (dari aro-mpd)
#   aro-music fill            antrean kosong -> isi dari folder aktif
#   aro-music folder          cetak folder aktif ("" = semua lagu)
# Folder aktif disimpan di ~/.local/state/aro-music/folder dan dipakai juga oleh
# tombol media (antrean kosong) dan aro-play (lagu dari superfile).
set -u
ST="${XDG_STATE_HOME:-$HOME/.local/state}/aro-music"
SEG="${XDG_RUNTIME_DIR:?}/aro-bar"
mkdir -p "$ST" "$SEG"
FOLDER_FILE="$ST/folder"
active() { cat "$FOLDER_FILE" 2>/dev/null || true; }
put() { printf '%s\n' "$2" > "$SEG/.$1.tmp" && mv -f "$SEG/.$1.tmp" "$SEG/$1"; }
music_dir() {
    sed -n 's/^music_directory *"\(.*\)"/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/mpd/mpd.conf" 2>/dev/null | head -n1
}
mpd_ok() { command -v mpc >/dev/null && mpc -q status >/dev/null 2>&1; }

text() {
    if ! mpd_ok; then put folder "~♫ –"; put shuffle "~SHUFFLE –"; put repeat "~REPEAT –"; return; fi
    local f; f="$(active)"
    put folder "♫ ${f:-Semua}"
    if mpc 2>/dev/null | grep -q 'random: on'; then put shuffle "SHUFFLE ON"
    else put shuffle "~SHUFFLE OFF"; fi
    local st; st="$(mpc 2>/dev/null)"
    if grep -q 'single: on' <<<"$st" && grep -q 'repeat: on' <<<"$st"; then put repeat "REPEAT ON"
    else put repeat "~REPEAT OFF"; fi
}

fill() {   # isi antrean dari folder aktif (folder hilang -> semua lagu)
    local f; f="$(active)"
    if [ -n "$f" ] && ! mpc -q add "$f" 2>/dev/null; then
        : > "$FOLDER_FILE"; f=""
    fi
    [ -n "$f" ] || mpc -q add / 2>/dev/null
}

folder_menu() {
    mpd_ok || { notify-send -a Musik "MPD tidak berjalan" 2>/dev/null; exit 1; }
    local dir cur pick
    dir="$(music_dir)"; [ -d "$dir" ] || { notify-send -a Musik "Perpustakaan tidak ditemukan" "$dir"; exit 1; }
    cur="$(active)"
    pick="$( { [ -z "$cur" ] && echo "● Semua lagu" || echo "  Semua lagu"
              (cd "$dir" && find -L . -mindepth 1 -type d ! -name '.*' -printf '%P\n' | sort) |
              while IFS= read -r d; do
                  [ "$d" = "$cur" ] && echo "● $d" || echo "  $d"
              done; } |
            fuzzel --dmenu --prompt 'Folder musik ❯ ' --lines 15 --width 60)" || exit 0
    pick="${pick:2}"
    [ "$pick" = "Semua lagu" ] && pick=""
    printf '%s' "$pick" > "$FOLDER_FILE"
    mpc -q clear
    fill
    mpc -q play 2>/dev/null
    notify-send -a Musik -t 2500 "♫ ${pick:-Semua lagu}" \
        "$(mpc playlist | wc -l) lagu$(mpc | grep -q 'random: on' && echo ', acak')" 2>/dev/null
    text
}

shuffle_toggle() {
    mpd_ok || exit 1
    mpc -q random
    notify-send -a Musik -t 1500 "Shuffle" "$(mpc | grep -q 'random: on' && echo ON || echo OFF)" 2>/dev/null
    text
}

repeat_toggle() {   # ulangi satu lagu: single + repeat; OFF: single mati (antrean tetap berulang)
    mpd_ok || exit 1
    if mpc | grep -q 'single: on'; then
        mpc -q single off
        notify-send -a Musik -t 1500 "Repeat" "OFF — lanjut ke lagu berikutnya" 2>/dev/null
    else
        mpc -q repeat on; mpc -q single on
        notify-send -a Musik -t 1500 "Repeat" "ON — $(mpc -f '[%artist% — ]%title%|%file%' current)" 2>/dev/null
    fi
    text
}

watch() {
    exec 9>"$SEG/.aro-music.lock"; flock -n 9 || exit 0
    while true; do
        text
        if mpd_ok; then mpc idle options playlist player >/dev/null 2>&1 || sleep 5
        else sleep 5; fi
    done
}

case "${1:-text}" in
    folder-menu)    folder_menu ;;
    shuffle-toggle) shuffle_toggle ;;
    repeat-toggle)  repeat_toggle ;;
    text)           text ;;
    watch)          watch ;;
    fill)           fill ;;
    folder)         active; echo ;;
    *) sed -n '2,10p' "$0"; exit 2 ;;
esac
