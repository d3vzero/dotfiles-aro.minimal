#!/bin/bash
# monitor-mode -- pick resolution + refresh rate via wlr-randr (aro supports
# wlr-output-management), with confirmation and automatic revert.
#   monitor-mode menu      pick from a list (MONITOR_MODES in the machine config,
#                          empty = every mode the monitor reports)
#   monitor-mode apply M [OUTPUT]  apply M (e.g. 2560x1600@240) without confirmation
#   monitor-mode restore   apply the saved mode of every monitor (run when aro starts)
# More than one monitor: the menu asks which one first. MONITOR_MODES only applies
# to the main monitor (MONITOR_OUTPUT, or the first one); others list what they
# report. Saved modes: ~/.local/state/aro-monitor/<output>.mode
set -uo pipefail
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/aro-monitor"
CONF=/etc/dotfiles-aro.minimal.conf
MODES="$( . "$CONF" 2>/dev/null; echo "${MONITOR_MODES:-}" )"
OUT_CONF="$( . "$CONF" 2>/dev/null; echo "${MONITOR_OUTPUT:-}" )"
CONFIRM_SECS=15

notify() { notify-send -a Display "$@" 2>/dev/null || true; }

outputs() {          # every enabled output, one per line
    wlr-randr 2>/dev/null | awk '/^[^ \t]/ { n = $1 } /Enabled: yes/ { print n }'
}

output_name() {      # main monitor: MONITOR_OUTPUT from the config, or the first enabled one
    if [ -n "$OUT_CONF" ]; then echo "$OUT_CONF"; return; fi
    outputs | head -n1
}

save_mode() {        # save_mode OUTPUT MODE
    mkdir -p "$STATE"; echo "$2" > "$STATE/$1.mode"
}

modes_of() {         # "W H refresh current(0/1)" per mode milik output $1
    wlr-randr | awk -v o="$1" '
        /^[^ \t]/ { on = ($1 == o); next }
        on && / px, .* Hz/ {
            split($1, wh, "x"); r = $3
            print wh[1], wh[2], r, (index($0, "current") ? 1 : 0)
        }'
}

current_mode() {     # WxH@refresh-persis
    modes_of "$1" | awk '$4 == 1 { printf "%sx%s@%s\n", $1, $2, $3; exit }'
}

exact_refresh() {    # refresh asli monitor untuk WxH yang paling dekat dengan R (selisih < 1 Hz)
    modes_of "$1" | awk -v w="$2" -v h="$3" -v r="$4" '
        $1 == w && $2 == h { d = $3 - r; if (d < 0) d = -d
                             if (d < 1 && (best == "" || d < bd)) { best = $3; bd = d } }
        END { if (best != "") print best }'
}

aspect() {
    if   [ $(( $1 * 10 )) -eq $(( $2 * 16 )) ]; then echo "16:10"
    elif [ $(( $1 * 9 ))  -eq $(( $2 * 16 )) ]; then echo "16:9"
    else echo "$1:$2"; fi
}

apply_mode() {       # apply_mode OUTPUT WxH@R  -> 0 kalau berhasil
    local o="$1" m="$2" wh r w h ex
    wh="${m%@*}"; r="${m#*@}"; r="${r%Hz}"; w="${wh%x*}"; h="${wh#*x}"
    ex="$(exact_refresh "$o" "$w" "$h" "$r")"
    if [ -n "$ex" ]; then
        wlr-randr --output "$o" --mode "${wh}@${ex}Hz"
    else
        # tidak ada di daftar EDID monitor -> mode kustom (bisa ditolak monitor)
        wlr-randr --output "$o" --custom-mode "${wh}@${r}Hz"
    fi
}

cmd_menu() {
    local o cur list choice sel prev ans main
    main="$(output_name)"; [ -n "$main" ] || { notify -u critical "Display" "No output found (wlr-randr)"; exit 1; }
    mapfile -t outs < <(outputs)
    o="$main"
    if (( ${#outs[@]} > 1 )); then           # more than one monitor: pick it first
        o="$(for x in "${outs[@]}"; do printf '%-10s %s\n' "$x" "$(current_mode "$x" | awk -F@ '{ printf "%s@%d", $1, $2 + 0.5 }')"; done |
             fuzzel --dmenu --lines "${#outs[@]}" --width 40 --prompt 'Monitor ❯ ' | awk '{ print $1 }')"
        [ -n "$o" ] || exit 0
    fi
    cur="$(current_mode "$o")"
    if [ -n "$MODES" ] && [ "$o" = "$main" ]; then
        list="$(printf '%s\n' $MODES)"
    else
        list="$(modes_of "$o" | awk '{ printf "%sx%s@%d\n", $1, $2, $3 + 0.5 }' | sort -t@ -k1,1r -k2,2nr -u)"
    fi
    choice="$(
        while read -r m; do
            [ -n "$m" ] || continue
            wh="${m%@*}"; r="${m#*@}"; w="${wh%x*}"; h="${wh#*x}"
            mark=""
            if [ -n "$cur" ] && [ "${cur%@*}" = "$wh" ] && \
               awk -v a="${cur#*@}" -v b="$r" 'BEGIN { d = a - b; exit !(d < 1 && d > -1) }'; then
                mark="  ● active"
            fi
            printf '%-10s @ %3s Hz   %-5s%s\n' "$wh" "$r" "$(aspect "$w" "$h")" "$mark"
        done <<<"$list" | fuzzel --dmenu --font monospace:size=11 --width 50 --lines 10 \
                                 --prompt "Display $o ❯ "
    )" || exit 0
    sel="$(awk '{ print $1 "@" $3 }' <<<"$choice")"
    [ -n "$sel" ] || exit 0
    case "$choice" in *active*)
        # the active mode was picked -> just save it as the login mode
        save_mode "$o" "$sel"
        notify "Display" "$o: saved $sel (applied again at login)"
        exit 0 ;;
    esac

    prev="$cur"
    if ! apply_mode "$o" "$sel"; then
        notify -u critical "Display" "Could not apply $sel (rejected by the driver or monitor)"; exit 1
    fi
    ans="$(printf 'Keep\nRevert\n' | timeout "$CONFIRM_SECS" \
           fuzzel --dmenu --prompt "Keep $sel? (reverts in ${CONFIRM_SECS}s) ❯ ")"
    if [ "$ans" = "Keep" ]; then
        save_mode "$o" "$sel"
        notify "Display" "$o: saved $sel (applied again at login)"
    else
        [ -n "$prev" ] && apply_mode "$o" "$prev"
        notify "Display" "Reverted to ${prev:-the previous mode}"
    fi
}

cmd_restore() {
    local o i f m
    for i in $(seq 1 20); do              # wait until aro answers wlr-randr
        [ -n "$(outputs)" ] && break; sleep 0.5
    done
    # older single-monitor state file -> the main monitor
    if [ -f "$STATE/mode" ]; then
        o="$(output_name)"; [ -n "$o" ] && mv -f "$STATE/mode" "$STATE/$o.mode"
    fi
    for f in "$STATE"/*.mode; do
        [ -f "$f" ] || continue
        o="$(basename "$f" .mode)"; m="$(cat "$f")"
        outputs | grep -qx "$o" || continue  # that monitor is not plugged in now
        apply_mode "$o" "$m" || notify -u critical "Display" "$o: saved mode $m could not be applied"
    done
}

case "${1:-menu}" in
    menu)    cmd_menu ;;
    apply)   o="${3:-$(output_name)}"; apply_mode "$o" "${2:?mode, e.g. 2560x1600@240}" ;;
    restore) cmd_restore ;;
    *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
