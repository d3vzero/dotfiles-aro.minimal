#!/bin/bash
# aro-bar -- isi segmen bar aro (patch 0008, kunci bar_segment) di
# $XDG_RUNTIME_DIR/aro-bar/<nama>, satu baris per file. Teks terang seperti jam;
# awalan '~' = redup (mati/tidak tersambung).
#   sysmon  CPU 12% 54°  RAM 9.4G  GPU 3% 41° 1.2G
#   net     ↓1.2M  wifi-rumah  ↑35K
#   bt      nama perangkat (terang) | BT (redup) | BT off (redup)
#   usb     USB <label> / USB 2 (terang, ada yang terpasang) | USB (redup)
#   display 2560x1600@300 | DP-3 2560x1600@300  HDMI-A-1 1920x1080@60 (lebih dari satu)
#   rec     ● REC 01:23 (terang, sedang merekam) | REC (redup)
#   spk     SPK 45% JBL Go 4 | SPK muted (redup)     (aro-bar-audio.sh)
#   mic     MIC 80% | MIC muted (redup)
#   recset  native MP4 / 1920x1200 MKV (redup; klik = ganti resolusi/format)
# Dijalankan dari config aro (exec = aro-bar). Satu putaran tiap INTERVAL
# detik dengan builtin bash; nvidia-smi satu proses yang terus berjalan;
# nmcli/bluetoothctl hanya tiap beberapa putaran.
set -u
RUN="${XDG_RUNTIME_DIR:?}"
DIR="$RUN/aro-bar"
GPUF="$DIR/.gpu"
INTERVAL="${ARO_BAR_INTERVAL:-2}"
mkdir -p "$DIR"

exec 9>"$DIR/.lock"
flock -n 9 || exit 0                      # satu instance saja

cleanup() { [ -n "${GPUPID:-}" ] && kill "$GPUPID" 2>/dev/null; rm -f "$DIR"/sysmon "$DIR"/net "$DIR"/bt "$DIR"/usb "$DIR"/display "$DIR"/rec "$DIR"/recset "$DIR"/spk "$DIR"/mic "$GPUF"; }
trap cleanup EXIT
trap 'exit 0' TERM INT

put() { printf '%s\n' "$2" > "$DIR/.$1.tmp" && mv -f "$DIR/.$1.tmp" "$DIR/$1"; }

human() {   # byte -> 512B 35K 1.2M 3.4G (bilangan bulat, tanpa bc)
    local b=$1
    if   (( b >= 1073741824 )); then printf '%d.%dG' $((b/1073741824)) $(((b%1073741824)*10/1073741824))
    elif (( b >= 1048576 ));    then printf '%d.%dM' $((b/1048576)) $(((b%1048576)*10/1048576))
    elif (( b >= 1024 ));       then printf '%dK' $((b/1024))
    else printf '%dB' "$b"; fi
}

CPUT=""
for h in /sys/class/hwmon/hwmon*; do
    case "$(cat "$h/name" 2>/dev/null)" in k10temp|coretemp|zenpower) CPUT="$h/temp1_input"; break;; esac
done

# GPU: NVIDIA -> nvidia-smi streaming ke file; AMD -> sysfs langsung
AMDGPU=""
if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then
    nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used \
        --format=csv,noheader,nounits -lms $((INTERVAL * 1000)) 2>/dev/null 9>&- |
    while IFS=', ' read -r u t m; do
        printf 'GPU %s%% %s° %s\n' "$u" "$t" "$(human $((m * 1048576)))" > "$GPUF.tmp" && mv -f "$GPUF.tmp" "$GPUF"
    done 9>&- &           # lock fd tidak diwariskan: restart aro-bar tidak terhalang
    GPUPID=$!
else
    for d in /sys/class/drm/card*/device; do
        [ -r "$d/gpu_busy_percent" ] && { AMDGPU="$d"; break; }
    done
fi

read_cpu() { local l; read -r l < /proc/stat; set -- $l; shift
             CPU_IDLE=$(( $4 + $5 )); CPU_TOT=0; for v; do CPU_TOT=$((CPU_TOT + v)); done; }
read_net() { NET_RX=0; NET_TX=0; local l   # "eth0:123 ..." bisa tanpa spasi
             while IFS= read -r l; do
                 [[ $l == *:* ]] || continue
                 l=${l/:/ }; set -- $l
                 [[ $1 == lo || ! $2 =~ ^[0-9]+$ ]] && continue
                 NET_RX=$((NET_RX + $2)); NET_TX=$((NET_TX + ${10}))
             done < /proc/net/dev; }

net_name() {   # koneksi aktif pertama selain loopback
    command -v nmcli >/dev/null || { echo "net"; return; }
    local n
    n="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$2 != "loopback" { print $1; exit }')"
    echo "${n:-offline}"
}
bt_text() {
    command -v bluetoothctl >/dev/null || return 1
    if ! bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then echo "~BT off"; return 0; fi
    local d
    d="$(bluetoothctl devices Connected 2>/dev/null | head -n1 | cut -d' ' -f3-)"
    if [ -n "$d" ]; then echo "$d"; else echo "~BT"; fi
}

usb_text() {   # perangkat yang dipasang udiskie di /run/media/$USER
    local base="/run/media/$USER/" n=0 first="" dev mnt rest
    while read -r dev mnt rest; do
        [[ $mnt == "$base"* ]] || continue
        n=$((n + 1)); [ -z "$first" ] && first="${mnt#"$base"}"
    done < /proc/self/mounts
    first="${first//\\040/ }"
    if (( n == 0 )); then echo "~USB"
    elif (( n == 1 )); then echo "USB ${first:0:16}"
    else echo "USB $n"; fi
}

disp_text() {   # mode aktif tiap monitor (wlr-randr), dibaca tiap 10 detik
    command -v wlr-randr >/dev/null || return 1
    wlr-randr 2>/dev/null | awk '
        /^[^ \t]/ { name = $1; next }
        / px, .*current/ { split($1, wh, "x"); n++
            out[n] = name; mode[n] = sprintf("%sx%s@%d", wh[1], wh[2], $3 + 0.5) }
        END { if (n == 1) { print mode[1]; exit }
              for (i = 1; i <= n; i++) printf "%s%s %s", (i > 1 ? "  " : ""), out[i], mode[i]
              if (n) print "" }'
}

# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/aro-bar-audio.sh"     # spk_text, mic_text

REC_STATE="$RUN/casual-record"
rec_text() {   # durasi dari file start yang ditulis casual-record (tanpa proses baru)
    local pid start now
    if [ -r "$REC_STATE/pid" ] && read -r pid < "$REC_STATE/pid" && kill -0 "$pid" 2>/dev/null &&
       [ -r "$REC_STATE/start" ] && read -r start < "$REC_STATE/start"; then
        printf -v now '%(%s)T' -1
        local d=$((now - start))
        printf '● REC %02d:%02d\n' $((d / 60)) $((d % 60))
    else
        echo "~REC"
    fi
}
recset_text() {
    local RES=native FORMAT=mp4
    [ -r "$HOME/.config/casual-record.conf" ] && . "$HOME/.config/casual-record.conf"
    echo "~$RES ${FORMAT^^}"
}

read_cpu; P_IDLE=$CPU_IDLE; P_TOT=$CPU_TOT
read_net; P_RX=$NET_RX; P_TX=$NET_TX
NAME="$(net_name)"; BT="$(bt_text)" || BT=""; DISP="$(disp_text)" || DISP=""
n=0

while [ -S "$RUN/${WAYLAND_DISPLAY:-wayland-0}" ]; do   # berhenti saat sesi aro selesai
    sleep "$INTERVAL"; n=$((n + 1))

    read_cpu
    dt=$((CPU_TOT - P_TOT)); di=$((CPU_IDLE - P_IDLE))
    cpu=$(( dt > 0 ? (100 * (dt - di)) / dt : 0 ))
    P_IDLE=$CPU_IDLE; P_TOT=$CPU_TOT
    line="CPU ${cpu}%"
    [ -n "$CPUT" ] && [ -r "$CPUT" ] && line+=" $(( $(<"$CPUT") / 1000 ))°"

    while read -r k v _; do
        case "$k" in MemTotal:) mt=$v;; MemAvailable:) ma=$v; break;; esac
    done < /proc/meminfo
    line+="  RAM $(human $(( (mt - ma) * 1024 )))"

    if [ -n "${GPUPID:-}" ] && [ -r "$GPUF" ]; then
        line+="  $(<"$GPUF")"
    elif [ -n "$AMDGPU" ]; then
        g="GPU $(<"$AMDGPU/gpu_busy_percent")%"
        t=$(cat "$AMDGPU"/hwmon/hwmon*/temp1_input 2>/dev/null | head -n1)
        [ -n "$t" ] && g+=" $((t / 1000))°"
        [ -r "$AMDGPU/mem_info_vram_used" ] && g+=" $(human $(<"$AMDGPU/mem_info_vram_used"))"
        line+="  $g"
    fi
    put sysmon "$line"

    read_net
    rx=$(( (NET_RX - P_RX) / INTERVAL )); tx=$(( (NET_TX - P_TX) / INTERVAL ))
    P_RX=$NET_RX; P_TX=$NET_TX
    (( n % 5 == 0 )) && NAME="$(net_name)"            # tiap 10 detik
    put net "↓$(human $rx)  $NAME  ↑$(human $tx)"

    if (( n % 3 == 0 )); then BT="$(bt_text)" || BT=""; fi   # tiap 6 detik
    if [ -n "$BT" ]; then put bt "$BT"; else rm -f "$DIR/bt"; fi

    put usb "$(usb_text)"
    put rec "$(rec_text)"
    put spk "$(spk_text)"
    put mic "$(mic_text)"
    put recset "$(recset_text)"

    (( n % 5 == 0 )) && { DISP="$(disp_text)" || DISP=""; }   # tiap 10 detik (monitor baru ikut)
    if [ -n "$DISP" ]; then put display "$DISP"; else rm -f "$DIR/display"; fi
done
