#!/bin/bash
# audio-menu output|input -- bottom bar segments SPK / MIC (click).
# Pick the default output (speaker, headset, Bluetooth like JBL Go 4) or input
# (microphone), plus volume up / down / mute. Running streams are moved to the
# chosen device too (move_streams), also apps WirePlumber had pinned elsewhere.
set -uo pipefail
kind="${1:-output}"
case "$kind" in
    output) list=sinks;   getdef=get-default-sink;   setdef=set-default-sink
            dev=@DEFAULT_AUDIO_SINK@;   title="Output"; mk=(up down mute) ;;
    input)  list=sources; getdef=get-default-source; setdef=set-default-source
            dev=@DEFAULT_AUDIO_SOURCE@; title="Input";  mk=(mic-up mic-down mic-mute) ;;
    *) echo "usage: audio-menu output|input" >&2; exit 1 ;;
esac

def="$(pactl "$getdef" 2>/dev/null)"
# AUDIO_HIDE_OUTPUTS (config mesin): output yang tidak pernah ditawarkan, regex
# tanpa beda huruf besar/kecil, mis. "Meteor" (jack headphone di mikrofon USB)
HIDE=""
[ "$kind" = output ] && HIDE="$( . /etc/dotfiles-aro.minimal.conf 2>/dev/null; echo "${AUDIO_HIDE_OUTPUTS:-}" )"
# name<TAB>description; inputs: no ".monitor" of outputs; never the recorder's mix sink
mapfile -t devs < <(pactl -f json list "$list" 2>/dev/null |
    jq -r '.[] | select((.name | endswith(".monitor") | not) and (.name | startswith("casual_record_mix") | not))
                | "\(.name)\t\(.description)"')
vol="$(wpctl get-volume "$dev" 2>/dev/null | awk '{ printf "%d%%%s", $2 * 100 + 0.5, ($3 ~ /MUTED/ ? " muted" : "") }')"

menu=""
shown=()
for d in "${devs[@]}"; do
    desc="${d#*$'\t'}"
    if [ -n "$HIDE" ] && grep -qiE "$HIDE" <<<"$desc" && [ "${d%%$'\t'*}" != "$def" ]; then continue; fi
    shown+=("$d")
done
devs=("${shown[@]}")
for d in "${devs[@]}"; do
    name="${d%%$'\t'*}"; desc="${d#*$'\t'}"
    if [ "$name" = "$def" ]; then menu+="●  $desc"$'\n'; else menu+="   $desc"$'\n'; fi
done
menu+="Volume +5%"$'\n'"Volume -5%"$'\n'"Mute / unmute"$'\n'
lines=$(( ${#devs[@]} + 3 ))

choice="$(printf '%s' "$menu" | fuzzel --dmenu --lines "$lines" --width 50 \
          --prompt "$title ${vol:-?} ❯ ")" || exit 0
case "$choice" in
    "Volume +5%")    exec media-key "${mk[0]}" ;;
    "Volume -5%")    exec media-key "${mk[1]}" ;;
    "Mute / unmute") exec media-key "${mk[2]}" ;;
esac
# Pindahkan stream yang SEDANG berjalan ke perangkat baru. Mengganti default saja
# tidak cukup: aplikasi yang pernah diarahkan ke perangkat tertentu (Sung lewat Qt,
# browser) diingat WirePlumber dan tetap di perangkat lama. Yang tidak dipindah:
# rekaman casual-record (sink casual_record_mix) dan rekaman dari monitor output.
move_streams() {
    local target="$1" id
    if [ "$kind" = output ]; then
        local skip; skip="$(pactl -f json list sinks 2>/dev/null |
            jq -r '[.[] | select(.name | startswith("casual_record_mix")) | .index] | join(" ")')"
        pactl -f json list sink-inputs 2>/dev/null |
            jq -r --arg skip " $skip " '.[] | select(($skip | contains(" \(.sink) ")) | not)
                  | select((.properties["node.name"] // "") | startswith("casual_record") | not) | .index' |
        while read -r id; do pactl move-sink-input "$id" "$target" 2>/dev/null; done
    else
        local skip; skip="$(pactl -f json list sources 2>/dev/null |
            jq -r '[.[] | select((.name | endswith(".monitor")) or (.name | startswith("casual_record_mix"))) | .index] | join(" ")')"
        pactl -f json list source-outputs 2>/dev/null |
            jq -r --arg skip " $skip " '.[] | select(($skip | contains(" \(.source) ")) | not)
                  | select((.properties["node.name"] // "") | startswith("casual_record") | not) | .index' |
        while read -r id; do pactl move-source-output "$id" "$target" 2>/dev/null; done
    fi
}

want="${choice:3}"
for d in "${devs[@]}"; do
    if [ "${d#*$'\t'}" = "$want" ]; then
        # Picking an output must not move the microphone (a Bluetooth speaker with
        # a mic can drag the default input along): keep the input as it was.
        src_before="$(pactl get-default-source 2>/dev/null)"
        pactl "$setdef" "${d%%$'\t'*}"
        if [ "$kind" = output ] && [ -n "$src_before" ]; then
            sleep 0.3
            [ "$(pactl get-default-source 2>/dev/null)" = "$src_before" ] || pactl set-default-source "$src_before"
        fi
        move_streams "${d%%$'\t'*}"
        notify-send -a Media -t 2000 "$title" "$want" 2>/dev/null
        aro-bar-refresh audio 2>/dev/null || true
        exit 0
    fi
done
