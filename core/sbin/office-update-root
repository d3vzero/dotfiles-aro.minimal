#!/bin/bash
# /usr/local/sbin/office-update-root — bagian update yang butuh root
# Dipanggil oleh office-update lewat: su Admin -c "sudo -n office-update-root <item...>"
# Hanya menerima item dari daftar putih: system onlyoffice superfile aro detectron2 proton
# Pasang: install -o root -g root -m 755 office-update-root /usr/local/sbin/
set -u
[ "$(id -u)" = 0 ] || { echo "!! harus dijalankan sebagai root"; exit 1; }
export LC_ALL=C.UTF-8

gh_latest() {
    curl -fsS --max-time 15 "https://api.github.com/repos/$1/releases/latest" 2>/dev/null |
        sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1
}

up_system() {
    echo "==> Sistem (pacman -Syu)"
    pacman -Sy || return 1
    # driver NVIDIA: tahan kalau multilib (lib32) dan world (dkms) beda versi
    # -- logika sama dengan nvidia_hold() di lib/apply.sh
    local gpu multi dkms ign=""
    gpu="$( . /etc/dotfiles-aro.minimal.conf 2>/dev/null; echo "${GPU:-}" )"
    if [ "$gpu" = nvidia ] && pacman -Q lib32-nvidia-utils >/dev/null 2>&1; then
        multi="$(pacman -Si lib32-nvidia-utils 2>/dev/null | awk '/^Version/ { print $3; exit }')"
        dkms="$(pacman -Si nvidia-open-dkms 2>/dev/null | awk '/^Version/ { print $3; exit }')"
        if [ -n "$multi" ] && [ -n "$dkms" ] && [ "$multi" != "$dkms" ]; then
            ign="nvidia-utils,lib32-nvidia-utils,opencl-nvidia,lib32-opencl-nvidia,nvidia-open-dkms"
            echo ">> Driver NVIDIA ditahan (multilib $multi, world $dkms): naik bersama setelah Artix menyusul."
        fi
    fi
    pacman -Su ${ign:+--ignore "$ign"} || return 1
    # kernel baru terpasang → folder modul kernel yang sedang jalan hilang
    if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
        echo ">> Kernel diperbarui: REBOOT dianjurkan (Ctrl+Alt+Del → Reboot)."
    fi
}

up_onlyoffice() {
    echo "==> OnlyOffice"
    local dir=/opt/onlyoffice latest cur
    [ -x "$dir/OnlyOffice.AppImage" ] || { echo "tidak terpasang (profil office) -- skip"; return 0; }
    latest=$(gh_latest ONLYOFFICE/DesktopEditors)
    [ -n "$latest" ] || { echo "!! gagal cek rilis OnlyOffice"; return 1; }
    cur=$(cat "$dir/VERSION" 2>/dev/null || echo "?")
    [ "$cur" = "$latest" ] && { echo "sudah terbaru ($cur)"; return 0; }
    echo "unduh $latest (~600 MB)…"
    curl -fL --progress-bar -o "$dir/OnlyOffice.AppImage.new" \
        "https://github.com/ONLYOFFICE/DesktopEditors/releases/download/$latest/DesktopEditors-x86_64.AppImage" \
        || { rm -f "$dir/OnlyOffice.AppImage.new"; echo "!! unduhan gagal"; return 1; }
    if [ "$(stat -c %s "$dir/OnlyOffice.AppImage.new")" -lt 100000000 ]; then
        rm -f "$dir/OnlyOffice.AppImage.new"; echo "!! file terlalu kecil, dibatalkan"; return 1
    fi
    chmod 755 "$dir/OnlyOffice.AppImage.new"
    mv -f "$dir/OnlyOffice.AppImage.new" "$dir/OnlyOffice.AppImage"   # aman walau sedang dibuka
    echo "$latest" > "$dir/VERSION"
    echo "OnlyOffice $cur → $latest. Tutup dan buka ulang OnlyOffice."
}

up_superfile() {
    echo "==> superfile"
    local latest cur tmp
    latest=$(gh_latest yorukot/superfile)
    [ -n "$latest" ] || { echo "!! gagal cek rilis superfile"; return 1; }
    cur=$(/usr/local/bin/spf --version 2>/dev/null | awk '{print $NF}')
    [ "$cur" = "$latest" ] && { echo "sudah terbaru ($cur)"; return 0; }
    tmp=$(mktemp -d)
    if curl -fsSL -o "$tmp/spf.tgz" \
         "https://github.com/yorukot/superfile/releases/download/$latest/superfile-linux-$latest-amd64.tar.gz" &&
       tar xzf "$tmp/spf.tgz" -C "$tmp" 2>/dev/null &&
       install -m 755 "$tmp/dist/superfile-linux-$latest-amd64/spf" /usr/local/bin/spf; then
        echo "superfile ${cur:-?} → $latest"
    else
        echo "!! update superfile gagal, versi lama tetap dipakai"; rm -rf "$tmp"; return 1
    fi
    rm -rf "$tmp"
}

up_aro() {
    # /opt/aro-src = clone dari dotfiles-aro.minimal (dibuild di tag ARO_REF,
    # HEAD detached). Update = pindah ke HEAD branch default upstream.
    echo "==> aro"
    local src=/opt/aro-src old new
    [ -d "$src/.git" ] && [ -d "$src/build" ] || { echo "!! $src belum ada (jalankan update.sh dulu)"; return 1; }
    git -C "$src" fetch -q origin || { echo "!! gagal fetch"; return 1; }
    old=$(git -C "$src" rev-parse HEAD)
    new=$(git -C "$src" rev-parse refs/remotes/origin/HEAD 2>/dev/null) \
        || { echo "!! origin/HEAD tidak dikenal"; return 1; }
    [ "$old" = "$new" ] && { echo "sudah terbaru (${old:0:7})"; return 0; }
    git -C "$src" log --oneline "$old..$new" | head -20
    # buang patch lokal dulu supaya checkout tidak bentrok, lalu pasang lagi
    git -C "$src" checkout -q -- .
    git -C "$src" checkout -q "$new" || { echo "!! checkout gagal"; return 1; }
    local pt
    for pt in /opt/dotfiles-aro.minimal/core/patches/aro/*.patch; do
        [ -e "$pt" ] || continue
        if ! git -C "$src" apply "$pt"; then
            echo "!! patch $(basename "$pt") tidak cocok dengan aro ${new:0:7} -- dibatalkan, aro lama tetap dipakai"
            git -C "$src" checkout -q -- .
            git -C "$src" checkout -q "$old"
            for pt in /opt/dotfiles-aro.minimal/core/patches/aro/*.patch; do git -C "$src" apply "$pt" 2>/dev/null || true; done
            return 1
        fi
        echo "patch aro: $(basename "$pt")"
    done
    if ninja -C "$src/build" && ninja -C "$src/build" install >/dev/null; then
        rm -rf /usr/share/backgrounds/aro
        echo "aro ${old:0:7} → ${new:0:7}. Aktif setelah reboot (Ctrl+Alt+Del → Reboot)."
        echo ">> Catatan: versi ini di luar ARO_REF yang dikunci; update.sh tidak menimpanya"
        echo "   kecuali dijalankan dengan UPDATE_ARO=1 (kembali ke ARO_REF)."
    else
        echo "!! build aro gagal, source dikembalikan ke ${old:0:7}; aro lama tetap dipakai"
        git -C "$src" checkout -q -- .
        git -C "$src" checkout -q "$old"
        for pt in /opt/dotfiles-aro.minimal/core/patches/aro/*.patch; do git -C "$src" apply "$pt" 2>/dev/null || true; done
        return 1
    fi
}

up_detectron2() {
    # Build ulang venv Detectron2 versi terbaru (venv lama dikembalikan kalau
    # gagal), lalu tes op CUDA di GPU. Opsi dari config mesin.
    echo "==> Detectron2"
    local s=/opt/dotfiles-aro.minimal/profiles/ai/install-detectron2.sh
    [ -x /opt/detectron2/venv/bin/python ] || { echo "tidak terpasang (profil ai) -- skip"; return 0; }
    [ -x "$s" ] || { echo "!! $s tidak ada"; return 1; }
    local TORCH_CUDA_ARCH="" D2_REV="" TORCH_INDEX="" req=/opt/dotfiles-aro.minimal/profiles/ai/shtrainer-requirements.txt
    # shellcheck disable=SC1091
    . /etc/dotfiles-aro.minimal.conf
    # shellcheck disable=SC1091
    [ -f /etc/dotfiles-aro.minimal.d/ai-trainer.conf ] && . /etc/dotfiles-aro.minimal.d/ai-trainer.conf
    local ok=0
    env TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH:-12.0}" D2_REV="${D2_REV:-}" TORCH_INDEX="${TORCH_INDEX:-}" \
        D2_EXTRA_REQ="$( [ -f "$req" ] && echo "$req" )" \
        "$s" rebuild && "$s" verify || ok=1
    rm -rf /tmp/uv-cache
    return $ok
}

up_proton() {
    # GE-Proton terbaru ke folder system-wide Steam. Versi lama TIDAK dihapus:
    # game yang dikunci ke versi lama tetap jalan; pilih versi baru per game.
    echo "==> Proton-GE"
    local dest=/usr/share/steam/compatibilitytools.d rel tag url sum tmp
    ls -d "$dest"/GE-Proton* >/dev/null 2>&1 || { echo "tidak terpasang (profil daily) -- skip"; return 0; }
    rel=$(curl -fsS --max-time 15 https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest) \
        || { echo "!! gagal cek rilis Proton-GE"; return 1; }
    tag=$(printf '%s' "$rel" | jq -r .tag_name)
    [ -n "$tag" ] && [ "$tag" != null ] || { echo "!! tag rilis tidak terbaca"; return 1; }
    if [ -d "$dest/$tag" ] || ls -d "$dest/$tag"-* >/dev/null 2>&1; then echo "sudah terbaru ($tag)"; return 0; fi
    # x86_64: utamakan *x86_64.tar.gz, kalau tidak ada ambil .tar.gz yang bukan aarch64
    url=$(printf '%s' "$rel" | jq -r '[.assets[].browser_download_url | select(endswith(".tar.gz"))]
          | (map(select(endswith("x86_64.tar.gz"))) + map(select(test("aarch64|arm64") | not)))[0] // empty')
    # semua file .sha512sum di rilis (sejak GE-Proton11 ada x86_64 DAN aarch64,
    # masing-masing punya file checksum sendiri)
    sum=$(printf '%s' "$rel" | jq -r '.assets[].browser_download_url | select(endswith(".sha512sum"))')
    [ -n "$url" ] || { echo "!! file x86_64 tidak ditemukan di rilis $tag"; return 1; }
    tmp=$(mktemp -d -p /var/tmp)
    echo "unduh $tag (~500 MB)…"
    if ! curl -fL --progress-bar -o "$tmp/$(basename "$url")" "$url"; then
        rm -rf "$tmp"; echo "!! unduhan gagal"; return 1
    fi
    if [ -n "$sum" ]; then
        # hash file kita harus ada di salah satu file .sha512sum rilis itu
        local h u n=0
        h=$(sha512sum "$tmp/$(basename "$url")" | cut -d' ' -f1)
        : > "$tmp/sums"
        for u in $sum; do
            curl -fsSL --max-time 30 "$u" >> "$tmp/sums" && n=$((n+1))
        done
        if [ "$n" -eq 0 ]; then
            rm -rf "$tmp"; echo "!! file checksum tidak bisa diunduh -- dibatalkan"; return 1
        elif grep -qi "$h" "$tmp/sums"; then
            echo "checksum sha512 cocok"
        else
            echo "!! checksum tidak cocok -- dibatalkan"
            echo "   file  : $(basename "$url") ($(stat -c %s "$tmp/$(basename "$url")") byte)"
            echo "   sha512: ${h:0:16}…"
            echo "   isi file checksum:"; sed 's/^/     /' "$tmp/sums" | cut -c1-110
            rm -rf "$tmp"; return 1
        fi
    fi
    # ekstrak di /var/tmp dulu, baru pindahkan: folder setengah jadi tidak pernah muncul di Steam
    mkdir -p "$tmp/x"
    local top
    if tar -xzf "$tmp/$(basename "$url")" -C "$tmp/x" &&
       top=$(ls -1 "$tmp/x") && [ "$(printf '%s\n' "$top" | wc -l)" = 1 ] &&
       [ -f "$tmp/x/$top/compatibilitytool.vdf" ] && [ ! -e "$dest/$top" ]; then
        mv "$tmp/x/$top" "$dest/$top"
        tag=$top
    else
        rm -rf "$tmp"; echo "!! ekstrak gagal"; return 1
    fi
    rm -rf "$tmp"
    echo "Proton-GE $tag terpasang. Terpasang sekarang:"
    du -sh "$dest"/GE-Proton* 2>/dev/null | sed 's#'"$dest"'/#   #'
    echo ">> Tutup Steam total lalu buka lagi. Per game: Properties → Compatibility →"
    echo "   centang 'Force…' → pilih $tag. Versi lama bisa dihapus manual kalau tidak dipakai:"
    echo "   sudo rm -rf $dest/GE-ProtonXX-YY"
}

rc=0
for item in "$@"; do
    echo
    case $item in
        system)     up_system     || rc=1 ;;
        onlyoffice) up_onlyoffice || rc=1 ;;
        superfile)  up_superfile  || rc=1 ;;
        aro)        up_aro        || rc=1 ;;
        detectron2) up_detectron2 || rc=1 ;;
        proton)     up_proton     || rc=1 ;;
        *) echo "!! item tidak dikenal: $item (diabaikan)"; rc=1 ;;
    esac
done
exit $rc
