+/* y for a bar text so that its baseline sits where plain text in the bar
+ * font would: centred by the font, not by this text's (maybe taller) layout */
+static int bar_text_y(const struct qtext *t, const char *font, int mid)
+{
+	static char cached[160];
+	static int fb, fh;
+	if (strcmp(cached, font)) {
+		qtext_font_metrics(font, &fb, &fh);
+		snprintf(cached, sizeof cached, "%s", font);
+	}
+	return mid - fh / 2 + fb - t->base;
+}
