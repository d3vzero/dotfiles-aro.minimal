+
+/* baseline and height of plain text in this font (logical px): lets callers
+ * line up texts by baseline, so a fallback glyph (symbol, CJK) that makes one
+ * layout taller does not lift that text off the line */
+void qtext_font_metrics(const char *font, int *base, int *height)
+{
+	cairo_surface_t *probe = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, 1, 1);
+	cairo_t *pcr = cairo_create(probe);
+	PangoLayout *l = layout_for(pcr, font, "Ag", 0);
+	int w = 0, h = 0;
+	pango_layout_get_pixel_size(l, &w, &h);
+	*base = pango_layout_get_baseline(l) / PANGO_SCALE;
+	*height = h;
+	g_object_unref(l);
+	cairo_destroy(pcr);
+	cairo_surface_destroy(probe);
 }
 
