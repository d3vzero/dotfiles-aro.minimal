+/* give the keyboard to an X11 surface without touching the managed focus */
+static void x11_keyboard_enter(struct aro_server *s, struct wlr_surface *surface)
+{
+	if (!surface || s->focused_layer)
+		return;
+	wlr_xwayland_set_seat(s->xwayland, s->seat);
+	struct wlr_keyboard *kb = wlr_seat_get_keyboard(s->seat);
+	if (kb)
+		wlr_seat_keyboard_notify_enter(s->seat, surface, kb->keycodes,
+		                               kb->num_keycodes, &kb->modifiers);
+	else
+		wlr_seat_keyboard_notify_enter(s->seat, surface, NULL, 0, NULL);
+}
+
+/* an override-redirect surface went away while it held the keyboard */
+static void x11_keyboard_restore(struct aro_server *s, struct wlr_xwayland_surface *x)
+{
+	if (!x->surface || s->seat->keyboard_state.focused_surface != x->surface)
+		return;
+	/* a parent that wants focus gets it back (menus inside menus) */
+	if (x->parent && x->parent->surface &&
+	    wlr_xwayland_surface_override_redirect_wants_focus(x->parent)) {
+		x11_keyboard_enter(s, x->parent->surface);
+		return;
+	}
+	if (s->focused && s->focused->mapped)
+		x11_keyboard_enter(s, view_surface(s->focused));
+	else
+		wlr_seat_keyboard_notify_clear_focus(s->seat);
+}
