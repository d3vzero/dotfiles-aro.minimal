+		int group = total + (n ? th->bar_pad * 2 : 0) + pills_w;
+		int gx = (b->w - group) / 2;
+		if (gx < th->bar_pad)
+			gx = th->bar_pad;
+		int ax = gx;
+		for (int i = 0; i < n; i++) {
+			b->app[i].x = ax;
+			qtext_move(&b->app[i].text, ax, mid - b->app[i].text.h / 2);
+			ax += b->app[i].w + th->bar_pad;
+		}
+		int shift = (n ? ax + th->bar_pad : gx) - th->bar_pad;
+		for (int i = 0; i < b->shown && i < b->nws; i++) {
+			b->ws[i].x += shift;
+			wlr_scene_node_set_position(&b->ws[i].pill->node, b->ws[i].x, mid - PILL_H / 2);
+			qtext_move(&b->ws[i].label, b->ws[i].x + PILL_PAD,
+			           mid - b->ws[i].label.h / 2);
+		}
+	}
 
-	qtext_set(&b->title, title ? title : "", th->ink, b->scale, avail);
-	qtext_move(&b->title, title_x, mid - b->title.h / 2);
+	/* the window title has no room left in this layout (the bottom bar
+	 * lists open windows instead) */
+	qtext_show(&b->title, false);
+}
+
+/* press on the bar: segment command, or the workspace pill under it */
+bool bar_click(struct aro_server *s, double lx, double ly)
+{
+	struct aro_output *o;
+	wl_list_for_each(o, &s->outputs, link) {
+		struct aro_bar *b = &o->bar;
+		int h = bar_height(b);
+		if (h <= 0 || lx < b->x || lx >= b->x + b->w || ly < b->y || ly >= b->y + h)
+			continue;
+		int x = (int)lx - b->x;
+		for (int i = 0; i < s->cfg.nbar_seg; i++) {
+			const struct bar_seg *g = &b->seg[i];
+			if (s->cfg.bar_seg[i].bar == Q_BAR_TOP && g->w > 0 &&
+			    x >= g->x && x < g->x + g->w) {
+				if (s->cfg.bar_seg[i].cmd[0])
+					config_spawn(s->cfg.bar_seg[i].cmd);
+				return true;
+			}
+		}
+		if (bar_bottom_height(b) <= 0) {
+			for (int i = 0; i < b->shown && i < b->nws; i++) {
+				if (x >= b->ws[i].x && x < b->ws[i].x + b->ws[i].w) {
+					s->focused_output = o;
+					workspace_show(s, i);
+					return true;
+				}
+			}
+		}
+		return true;            /* the bar itself: nothing under it to click */
+	}
+
+	/* the bottom strip: pills, windows, bottom segments */
+	wl_list_for_each(o, &s->outputs, link) {
+		struct aro_bar *b = &o->bar;
+		int h = bar_bottom_height(b);
+		if (h <= 0 || lx < b->x || lx >= b->x + b->w || ly < b->by || ly >= b->by + h)
+			continue;
+		int x = (int)lx - b->x;
+		for (int i = 0; i < s->cfg.nbar_seg; i++) {
+			const struct bar_seg *g = &b->seg[i];
+			if (s->cfg.bar_seg[i].bar == Q_BAR_BOTTOM && g->w > 0 &&
+			    x >= g->x && x < g->x + g->w) {
+				if (s->cfg.bar_seg[i].cmd[0])
+					config_spawn(s->cfg.bar_seg[i].cmd);
+				return true;
+			}
+		}
+		for (int i = 0; i < b->shown && i < b->nws; i++) {
+			if (x >= b->ws[i].x && x < b->ws[i].x + b->ws[i].w) {
+				s->focused_output = o;
+				workspace_show(s, i);
+				return true;
+			}
+		}
+		for (int i = 0; i < b->napp; i++) {
+			struct aro_view *v = b->app[i].view;
+			if (v && x >= b->app[i].x && x < b->app[i].x + b->app[i].w) {
+				/* still open? the list is rebuilt every second */
+				struct aro_view *it;
+				wl_list_for_each(it, &s->views, link)
+					if (it == v && it->mapped) {
+						view_raise_and_focus(s, v);
+						break;
+					}
+				return true;
+			}
+		}
+		return true;
+	}
+	return false;
 }
 
