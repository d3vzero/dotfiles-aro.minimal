+/* ── segments ──────────────────────────────────────────────────────────── */
+
+/*
+ * bar_segment text lives in $XDG_RUNTIME_DIR/aro-bar/<name>, one line, kept
+ * by a script (aro-bar). A leading '*' means "on": drawn bright instead of
+ * dim. Reading a few tiny tmpfs files on the 1 s clock tick costs nothing
+ * and never blocks the compositor on slow tools (nvidia-smi, nmcli, ...).
+ */
+static bool seg_read(const char *name, char *buf, size_t n, bool *bright)
+{
+	const char *dir = getenv("XDG_RUNTIME_DIR");
+	if (!dir || !*dir)
+		return false;
+	char path[512];
+	snprintf(path, sizeof path, "%s/aro-bar/%s", dir, name);
+	FILE *f = fopen(path, "r");
+	if (!f)
+		return false;
+	char line[256];
+	bool ok = fgets(line, sizeof line, f) != NULL;
+	fclose(f);
+	if (!ok)
+		return false;
+	line[strcspn(line, "\r\n")] = '\0';
+	const char *t = line;
+	*bright = (*t == '*');
+	if (*bright)
+		t++;
+	snprintf(buf, n, "%s", t);
+	return buf[0] != '\0';
+}
+
+/* draw one segment at x (left edge) or ending at x (right edge) */
+static int seg_draw(struct aro_bar *b, int i, int x, bool from_right, int mid)
+{
+	struct aro_server *s = b->output->server;
+	const struct q_theme *th = &s->cfg.theme;
+	struct bar_seg *g = &b->seg[i];
+	char text[256];
+	bool bright = false;
+	if (!seg_read(s->cfg.bar_seg[i].name, text, sizeof text, &bright)) {
+		qtext_show(&g->text, false);
+		g->w = 0;
+		return x;
+	}
+	qtext_show(&g->text, true);
+	qtext_set(&g->text, text, bright ? th->ink : th->dim, b->scale, 0);
+	g->w = g->text.w;
+	g->x = from_right ? x - g->w : x;
+	qtext_move(&g->text, g->x, mid - g->text.h / 2);
+	return from_right ? g->x - th->bar_pad : g->x + g->w + th->bar_pad;
+}
+
