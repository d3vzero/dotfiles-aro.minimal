+/* ── segments ──────────────────────────────────────────────────────────── */
+
+/*
+ * bar_segment text lives in $XDG_RUNTIME_DIR/aro-bar/<name>, one line, kept
+ * by a script (aro-bar). A leading '*' means "on": drawn bright instead of
+ * dim. Reading a few tiny tmpfs files on the 1 s clock tick costs nothing
+ * and never blocks the compositor on slow tools (nvidia-smi, nmcli, ...).
+ */
+static bool seg_read(const char *name, char *buf, size_t n, bool *bright)
+{
+	const char *dir = getenv("XDG_RUNTIME_DIR");
+	if (!dir || !*dir)
+		return false;
+	char path[512];
+	snprintf(path, sizeof path, "%s/aro-bar/%s", dir, name);
+	FILE *f = fopen(path, "r");
+	if (!f)
+		return false;
+	char line[256];
+	bool ok = fgets(line, sizeof line, f) != NULL;
+	fclose(f);
+	if (!ok)
+		return false;
+	line[strcspn(line, "\r\n")] = '\0';
+	const char *t = line;
+	*bright = (*t != '~');
+	if (*t == '~' || *t == '*')
+		t++;
+	snprintf(buf, n, "%s", t);
+	return buf[0] != '\0';
+}
+
+/* "Sans 12" -> "Sans Bold 12" (pango wants the size last) */
+static void bold_font(const char *font, char *out, size_t n)
+{
+	const char *sp = strrchr(font, ' ');
+	if (sp && sp[1] >= '0' && sp[1] <= '9')
+		snprintf(out, n, "%.*s Bold%s", (int)(sp - font), font, sp);
+	else
+		snprintf(out, n, "%s Bold", font);
+}
+
+/* short name for the window list: last part of a reverse-DNS app id; games
+ * under Proton (steam_app_<id>) show their title instead */
+static void app_label(struct aro_view *v, char *out, size_t n)
+{
+	const char *id = view_app_id(v);
+	const char *title = view_title(v);
+	if (!id || !*id || !strncmp(id, "steam_app_", 10)) {
+		snprintf(out, n, "%.20s", title && *title ? title : "?");
+		return;
+	}
+	const char *dot = strrchr(id, '.');
+	snprintf(out, n, "%.20s", dot && dot[1] ? dot + 1 : id);
+}
+
+/* draw one segment at x (left edge) or ending at x (right edge) */
+static int seg_draw(struct aro_bar *b, int i, int x, bool from_right, int mid)
+{
+	struct aro_server *s = b->output->server;
+	const struct q_theme *th = &s->cfg.theme;
+	struct bar_seg *g = &b->seg[i];
+	struct wlr_scene_tree *home = s->cfg.bar_seg[i].bar == Q_BAR_BOTTOM ? b->btree : b->tree;
+	if (g->text.node && g->text.node->node.parent != home)
+		wlr_scene_node_reparent(&g->text.node->node, home);
+	char text[256];
+	bool bright = false;
+	if (!seg_read(s->cfg.bar_seg[i].name, text, sizeof text, &bright)) {
+		qtext_show(&g->text, false);
+		g->w = 0;
+		return x;
+	}
+	qtext_show(&g->text, true);
+	qtext_set(&g->text, text, bright ? th->ink : th->dim, b->scale, 0);
+	g->w = g->text.w;
+	g->x = from_right ? x - g->w : x;
+	qtext_move(&g->text, g->x, mid - g->text.h / 2);
+	return from_right ? g->x - th->bar_pad : g->x + g->w + th->bar_pad;
+}
