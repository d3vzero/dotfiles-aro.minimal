+/* press on the bar: segment command, or the workspace pill under it */
+bool bar_click(struct aro_server *s, double lx, double ly)
+{
+	struct aro_output *o;
+	wl_list_for_each(o, &s->outputs, link) {
+		struct aro_bar *b = &o->bar;
+		int h = bar_height(b);
+		if (h <= 0 || lx < b->x || lx >= b->x + b->w || ly < b->y || ly >= b->y + h)
+			continue;
+		int x = (int)lx - b->x;
+		for (int i = 0; i < s->cfg.nbar_seg; i++) {
+			const struct bar_seg *g = &b->seg[i];
+			if (g->w > 0 && x >= g->x && x < g->x + g->w) {
+				if (s->cfg.bar_seg[i].cmd[0])
+					config_spawn(s->cfg.bar_seg[i].cmd);
+				return true;
+			}
+		}
+		for (int i = 0; i < b->shown && i < b->nws; i++) {
+			if (x >= b->ws[i].x && x < b->ws[i].x + b->ws[i].w) {
+				s->focused_output = o;
+				workspace_show(s, i);
+				return true;
+			}
+		}
+		return true;            /* the bar itself: nothing under it to click */
+	}
+	return false;
 }
 
